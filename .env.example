DATABASE_URL=postgresql+psycopg://memory_user:your-local-password@127.0.0.1:5432/memory_dev
LOCAL_USER_ID=local-dev-user
TESSERACT_LANGUAGES=eng


# Backend only; set OPENAI_API_KEY securely in the server environment.
OPENAI_VISION_MODEL=gpt-5.6-luna
OPENAI_RAG_MODEL=gpt-5.6-luna

# Local mode never performs startup migrations.
APP_ENV=local
AUTH_MODE=local
STORAGE_BACKEND=local
REQUEST_DEADLINE_SECONDS=25
# Migration command requires this separate DIRECT URL and --apply; never set it to a personal DB for tests.
# MIGRATION_DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/memory_test_example
# Cloud runtime: APP_ENV=cloud, AUTH_MODE=cognito, STORAGE_BACKEND=s3
# DATABASE_URL=postgresql+psycopg://user:password@ep-example-pooler.ap-southeast-2.aws.neon.tech/db?sslmode=require
# COGNITO_ISSUER=https://cognito-idp.ap-southeast-2.amazonaws.com/REGION_POOL
# COGNITO_CLIENT_ID=public-mobile-client-id
# S3_BUCKET=private-originals-bucket
